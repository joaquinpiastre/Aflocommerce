# ==========================================
# Aflo Ecommerce — variables de entorno
# Copiar este archivo a .env y completar los valores.
# ==========================================

# --- Base de datos (PostgreSQL — Neon o Supabase) ---
# Neon: https://neon.tech  |  Supabase: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL="postgresql://user:password@host:5432/aflo?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generar con: npx auth secret   (o `openssl rand -base64 33`)
AUTH_SECRET="reemplazar-por-un-secreto-aleatorio"
# URL pública del sitio (usada por Auth.js y para metadatos/OG)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Si se dejan vacías, el botón "Continuar con Google" queda deshabilitado
# y solo funciona el login por email/contraseña.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Nota: el checkout no usa pasarela de pago online. El cliente elige
# efectivo o transferencia, la orden queda "Pendiente" y se marca como
# "Pagado" manualmente desde el panel admin una vez confirmado el pago.

# --- Subida de imágenes de categorías (Vercel Blob) ---
# Se crea automáticamente al enlazar el proyecto a un Blob store de Vercel
# (`vercel blob create-store`) o se copia desde Vercel → Project → Storage.
BLOB_READ_WRITE_TOKEN=""

# --- Subida de imágenes de productos (UploadThing) ---
# https://uploadthing.com/dashboard — todavía no conectado; mientras tanto
# las imágenes de producto se cargan pegando una URL.
UPLOADTHING_TOKEN=""

# --- Email transaccional (opcional, hook de confirmación de orden) ---
RESEND_API_KEY=""
EMAIL_FROM="Aflo <pedidos@aflo.com>"
